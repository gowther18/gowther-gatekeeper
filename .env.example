# Copy to .env (local) or set as env vars in the Vercel dashboard.
# NEVER commit a real secret. The HMAC secret comes from the Agent Games
# dashboard (Rotate Secret) — it is shown once.
AGENT_GAMES_HMAC_SECRET=
# HMAC signature encoding: hex (default, lowercase, no prefix) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex
# Task-id -> field-element mapping: keccak (default), numeric, hex.
# Confirm against a practice task; switch if the platform rejects proofs.
GATEKEEPER_TASK_ID_MODE=keccak
# Local server only:
PORT=8080
# Optional: override the state-file path (default ./data/state.json locally,
# /tmp/gatekeeper-state.json on Vercel).
# GATEKEEPER_STATE_PATH=
# Optional: proof-generation soft budget in ms (default 8000).
# SOFT_BUDGET_MS=8000
